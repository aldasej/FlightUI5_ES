<mvc:View 
    controllerName="flightui5v2.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"  
    xmlns="sap.m" > 
    <Page id="ObjectPageID">

    <!-- <Text id="testID" text="This is the Object Page" /> -->

    <Table id="_IDGenTable" 
		items="{
			path: '/FlightDetailsES'
		}">
		<headerToolbar>
			<OverflowToolbar id="_IDGenOverflowToolbar1" >
				<Title id="_IDGenTitle1"  text="{Products}" level="H2"/>
				<ToolbarSpacer id="_IDGenToolbarSpacer1" />
				<Button id="_IDGenButton1"  text="Open Dialog" press="onOpenPressed"/>
			</OverflowToolbar>
		</headerToolbar>
		<columns>
			<Column id="_IDGenColumn4" >
				<Text id="_IDGenText9"  text="{i18n>connNo}" />
			</Column>
			<Column id="_IDGenColumn5" >
				<Text id="_IDGenText10"  text="{i18n>flightDate}" />
			</Column>
			<Column id="_IDGenColumn6">
				<Text id="_IDGenText11" text="{i18n>airfare}" />
			</Column>
			<Column id="_IDGenColumn7">
				<Text id="_IDGenText12" text="{i18n>airlineLocalCurrency}" />
			</Column>
			<Column id="_IDGenColumn8">
				<Text id="_IDGenText13"  text="{i18n>maxTypeEco}" />
			</Column>
			<Column id="_IDGenColumn9">
				<Text id="_IDGenText14" text="{i18n>occSeatsEco}" />
			</Column>
			<Column id="_IDGenColumn10">
				<Text id="_IDGenText15" text="{i18n>maxTypeBsns}" />
			</Column>
			<Column id="_IDGenColumn11">
				<Text id="_IDGenText16" text="{i18n>occSeatsBsns}" />
			</Column>
			<Column id="_IDGenColumn12">
				<Text id="_IDGenText17" text="{i18n>maxTypeFrst}" />
			</Column>
			<Column id="_IDGenColumn13">
				<Text id="_IDGenText18" text="{i18n>occSeatsFrst}" />
			</Column>
		</columns>
		<items>
			<ColumnListItem id="_IDGenColumnListItem1" vAlign="Middle" type="Navigation">
				<cells>
					<Text id="_IDGenText19" text="{Connid}" wrapping="false" />
					<Text id="_IDGenText20"  text="{Fldate}" wrapping="false"/>
					<Text id="_IDGenText21"  text="{Price}" />
					<Text id="_IDGenText22"  text="{Currency}" />
					<Text id="_IDGenText23"  text="{PlaneType}" />
					<Text id="_IDGenText24"  text="{SeatsMax}" />
					<Text id="_IDGenText25"  text="{SeatsOcc}" />
					<Text id="_IDGenText26"  text="{PaymentSum}" />
					<Text id="_IDGenText27"  text="{SeatsmaxB}" />
					<Text id="_IDGenText28"  text="{SeatsoccB}" />
					<Text id="_IDGenText29"  text="{SeatsmaxF}" />
					<Text id="_IDGenText30"  text="{SeatsoccF}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>


    </Page>

</mvc:View>
